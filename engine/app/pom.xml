<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>aie</groupId>
        <artifactId>engine-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>engine-app</artifactId>
    <name>Startup entry</name>

    <dependencies>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-http</artifactId>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-modules</artifactId>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-core</artifactId>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-ports</artifactId>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-adapter-store-postgres</artifactId>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-adapter-model-fake</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Reads the region packs (M3-1). The jar already carries it for Spring Boot's own YAML. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>aie</groupId>
            <artifactId>engine-adapter-store-postgres</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>engine</finalName>
        <!--
            The region packs go into the jar from the repository's regions/ (M3-1), so every pack is fixed when the engine
            is built and checked by CI, and DEPLOY_REGION only picks one.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../../regions</directory>
                <targetPath>regions</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>aie.app.EngineApplication</mainClass>
                    <includeTools>false</includeTools>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                Tests tagged packaged-jar run the packaged engine.jar, so they run after package, in integration-test.
                The default execution runs before package and leaves them out, even when -Dtest names one.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludedGroups>packaged-jar</excludedGroups>
                        </configuration>
                    </execution>
                    <execution>
                        <id>packaged-jar</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>packaged-jar</groups>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
